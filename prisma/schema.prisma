// Prisma schema for Nexus Travel AI

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Trip {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  status      String   @default("saved") @db.VarChar(20)
  destination String   @db.VarChar(100)
  startDate   DateTime?
  endDate     DateTime?
  trip        Json
  days        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}
